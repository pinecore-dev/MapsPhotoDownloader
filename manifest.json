{
  "manifest_version": 3,
  "name": "Maps Photo Downloader",
  "version": "0.6.1",
  "description": "Muestra en un panel lateral las fotos de un lugar de Google Maps para elegirlas y descargarlas.",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.googleusercontent.com/*",
    "*://*.ggpht.com/*",
    "https://www.google.com/maps/*",
    "https://www.google.com.uy/maps/*",
    "https://www.google.com.ar/maps/*",
    "https://www.google.es/maps/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.com.uy/maps/*",
        "https://www.google.com.ar/maps/*",
        "https://www.google.es/maps/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Abrir galería de fotografías",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png",
      "128": "icons/idle-128.png"
    }
  },
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
